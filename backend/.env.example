# Template only. Copy this to backend/.env and fill it in there.
# backend/.env is gitignored; this file is NOT, so never put a real secret here.

# MongoDB Atlas > Connect > Drivers. Keep credentials on the server; never use NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=safetyquest
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SETUP_TOKEN=
# Public site origin for invite emails and password links (no trailing slash).
# APP_PUBLIC_URL=http://localhost:8443
# APP_ORIGIN=http://localhost:8443

# Signing key for session tokens. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Email delivery for the one-time password code -------------------------
# Gmail: turn on 2-Step Verification first, then create an App Password at
# https://myaccount.google.com/apppasswords — SMTP_PASS is that 16-character value,
# never your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SafetyQuest <no-reply@yourschool.edu.ph>"

# Optional parent SMS verification and student account notifications (mobile).
# Email uses SMTP above. Leave these empty to disable the SMS option.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Mobile app -------------------------------------------------------------
# The school server address the Flutter app calls. PUBLIC: it is built into the
# APK. mobile/android/app/build.gradle.kts copies ONLY this line into the app; nothing
# else in this file ever reaches the phone.
# Physical phone on the same Wi-Fi: this PC's LAN IP (run `ipconfig`, IPv4 Address).
# Android emulator: http://10.0.2.2:8443. Release builds need an https:// address.
API_BASE_URL=http://192.168.1.10:8443
